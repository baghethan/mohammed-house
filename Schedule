<body>
<div id="app"></div>
<script>
var M='morning',N='night',A='afternoon',O='off',L='leave',I='inactive',W='watch',C='cover',K='oncall';
var DAYS_AR=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
var DAYS_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
var DAYS=DAYS_AR; /* compatibility - updated in render */

var REF=new Date('2026-01-04');

/* ── SETTINGS ── */
var REGION = localStorage.getItem('jadwal_region') || 'eastern'; /* eastern | riyadh | jeddah */
var LANG   = localStorage.getItem('jadwal_lang')   || 'ar';      /* ar | en */

var REGIONS = {
  eastern: {label_ar:'المنطقة الشرقية', label_en:'Eastern Province', morning:'7:30am-5:00pm', morning_ar:'7:30ص-5:00م'},
  riyadh:  {label_ar:'الرياض',          label_en:'Riyadh',           morning:'8:00am-5:30pm', morning_ar:'8:00ص-5:30م'},
  jeddah:  {label_ar:'جدة',             label_en:'Jeddah',           morning:'8:00am-5:30pm', morning_ar:'8:00ص-5:30م'}
};
var SAT_TIME    = '9:00am-7:00pm';
var SAT_TIME_AR = '9:00ص-7:00م';
function satTime(){ return LANG==='en'?SAT_TIME:SAT_TIME_AR; }

function T(ar, en) { return LANG === 'en' ? en : ar; }
function morningTime(empRegion) {
  var r = empRegion || REGION;
  return LANG === 'en' ? REGIONS[r].morning : REGIONS[r].morning_ar;
}
function empRegionLabel(e) {
  var r = e.region || REGION;
  return LANG === 'en' ? REGIONS[r].label_en : REGIONS[r].label_ar;
}
var CATS={
  emp:{label:'موظف أساسي',badge:'cat-emp'},
  sup:{label:'مشرف',badge:'cat-sup'},
  mgr:{label:'مدير',badge:'cat-mgr'},
  tra:{label:'متدرب',badge:'cat-tra'},
  tam:{label:'التمهير',badge:'cat-tam'}
};
var EXTRA_FIELDS=[
  {key:'jobTitle',label:'المسمى الوظيفي',type:'text',ph:'مهندس دعم فني'},
  {key:'empNum',label:'رقم الموظف',type:'text',ph:'مثال: 1042'},
  {key:'email',label:'البريد الإلكتروني (almajdouie.com)',type:'email',ph:'name@almajdouie.com'},
  {key:'phone',label:'رقم الجوال',type:'text',ph:'05xxxxxxxx'},
  {key:'dept',label:'القسم / الإدارة',type:'text',ph:'تقنية المعلومات'}
];
/* region is handled separately, not via EXTRA_FIELDS */

function loadState(){
  try{var s=localStorage.getItem('jadwal_v6');if(s)return JSON.parse(s);}catch(x){}
  return null;
}
function saveState(){
  try{localStorage.setItem('jadwal_v6',JSON.stringify({emps:EMPS,leaves:LEAVES}));}catch(x){}
}

var DEF=[
  {id:'abdulrahman',name:'Abdulrahman Ghulam Al-Sulaimani',category:'emp',core:true,fixed:false,active:true,rotates:true,jobTitle:'دعم فني',empNum:'',email:'',phone:'',dept:'',region:'eastern'},
  {id:'essa',name:'Essa Swaydi Alsalami',category:'emp',core:true,fixed:false,active:true,rotates:true,jobTitle:'دعم فني',empNum:'',email:'',phone:'',dept:'',region:'eastern'},
  {id:'saleh',name:'Saleh Sabri Aljuraydi',category:'emp',core:true,fixed:false,active:true,rotates:true,jobTitle:'دعم فني',empNum:'',email:'',phone:'',dept:'',region:'eastern'},
  {id:'hamad',name:'Hamad Rashid Al-Khathran',category:'emp',core:true,fixed:false,active:true,rotates:true,jobTitle:'دعم فني',empNum:'',email:'',phone:'',dept:'',region:'eastern'},
  {id:'ziyad',name:'Ziyad Fawaz Althaqfiy',category:'emp',core:true,fixed:false,active:true,rotates:true,jobTitle:'دعم فني',empNum:'',email:'',phone:'',dept:'',region:'eastern'}
];

var sv=loadState();
var EMPS=sv?sv.emps:DEF;
var LEAVES=sv?sv.leaves:[];
EMPS.forEach(function(e){
  if(!e.category)e.category='emp';
  if(e.fixed===undefined)e.fixed=false;
  if(e.active===undefined)e.active=!!e.core;
  if(e.rotates===undefined)e.rotates=!!e.core&&!e.fixed;
  /* مسح التثبيت التلقائي القديم من بيانات localStorage القديمة */
  if(sv&&e.id==='abdulrahman'&&e.fixed&&e.rotates===false){
    e.fixed=false; e.rotates=true;
  }
  EXTRA_FIELDS.forEach(function(f){if(e[f.key]===undefined)e[f.key]='';});
  if(!e.region)e.region='eastern';
});

var curSun=gwStart(new Date());
var activeTab='schedule';
var openForm=null;
var editingEmp=null;
/* weekly overrides: key="empId_YYYY-MM-DD" value=shift string */
var OVERRIDES = (function(){try{var s=localStorage.getItem('jadwal_overrides');return s?JSON.parse(s):{}}catch(e){return {};}})();
function saveOverrides(){try{localStorage.setItem('jadwal_overrides',JSON.stringify(OVERRIDES));}catch(e){}}
function overrideKey(empId,weekSun){return empId+'_'+fmtI(weekSun);}

function gwStart(d){var dt=new Date(d);dt.setDate(dt.getDate()-dt.getDay());dt.setHours(0,0,0,0);return dt;}
function aD(d,n){var r=new Date(d);r.setDate(r.getDate()+n);return r;}
function fmtF(d){return d.getDate()+'/'+(d.getMonth()+1)+'/'+d.getFullYear();}
function fmtI(d){return d.toISOString().split('T')[0];}
function fmtAR(d){return d.getDate()+'/'+(d.getMonth()+1);}
function pd(s){var p=s.split('-');return new Date(+p[0],+p[1]-1,+p[2]);}
function findEmp(id){return EMPS.find(function(e){return e.id===id;});}
function validEmail(em){return !em||em.toLowerCase().endsWith('@almajdouie.com');}

function onLeave(eid,date){
  var d=new Date(date);d.setHours(0,0,0,0);
  for(var i=0;i<LEAVES.length;i++){
    var lv=LEAVES[i];
    if(lv.empId!==eid)continue;
    var s=pd(lv.startDate);s.setHours(0,0,0,0);
    var e2=pd(lv.endDate);e2.setHours(0,0,0,0);
    if(d>=s&&d<=e2)return true;
  }
  return false;
}
function nightCover(date){
  var d=new Date(date);d.setHours(0,0,0,0);
  /* find leave for any fixed-night employee with a cover assigned */
  for(var i=0;i<LEAVES.length;i++){
    var lv=LEAVES[i];
    if(!lv.nightCoverId)continue;
    var fe=EMPS.find(function(e){return e.id===lv.empId&&e.fixed;});
    if(!fe)continue;
    var s=pd(lv.startDate);s.setHours(0,0,0,0);
    var e2=pd(lv.endDate);e2.setHours(0,0,0,0);
    if(d>=s&&d<=e2)return lv.nightCoverId;
  }
  return null;
}
function lvStatus(lv){
  var now=new Date();now.setHours(0,0,0,0);
  var s=pd(lv.startDate);s.setHours(0,0,0,0);
  var e2=pd(lv.endDate);e2.setHours(0,0,0,0);
  if(now>=s&&now<=e2)return 'active';
  if(now<s)return 'future';
  return 'past';
}

function rotPool(){return EMPS.filter(function(e){return e.active&&e.rotates&&!e.fixed&&(e.category==='emp'||e.category==='tra'||e.category==='tam');});}

function baseShifts(emp,ws){
  if(!emp.active)return [I,I,I,I,I,I,I];
  /* non-emp categories */
  if(emp.category!=='emp'){
    if(emp.fixed)return [N,N,N,N,N,O,O];
    if(emp.rotates){ /* fall through to rotation logic below */ }
    else if(emp.category==='sup'||emp.category==='mgr'){
      /* rotate on-call Friday among all active sup+mgr */
      var supPool=EMPS.filter(function(e){return e.active&&(e.category==='sup'||e.category==='mgr');});
      var sn2=supPool.length;
      if(sn2>0){
        var swk=Math.abs(Math.round((weekSun-REF)/(7*86400000)))%sn2;
        var onCallEmp=supPool[swk];
        if(onCallEmp&&onCallEmp.id===emp.id)return [W,W,W,W,W,K,O]; /* هذا الأسبوع أون كول */
      }
      return [W,W,W,W,W,O,O]; /* باقي الأسابيع إجازة جمعة */
    }
    else return [W,W,W,W,W,O,O];
  }
  if(emp.fixed)return [N,N,N,N,N,O,O]; /* ليلي ثابت: أحد-خميس ليلي | إجازة جمعة+سبت ✓ */
  if(!emp.rotates)return [M,M,M,M,M,O,O];
  var pool=rotPool();
  var n=pool.length;
  if(!n)return [M,M,M,M,M,O,O];
  var wk=Math.abs(Math.round((ws-REF)/(7*86400000)))%n;
  var mi=pool.findIndex(function(e){return e.id===emp.id;});
  if(mi<0)return [M,M,M,M,M,O,O];
  /* دورة معتمدة — جميع الإجازات متتالية ✓ — 5 أيام لكل موظف ✓
     سبت ليلي  : إجازة أحد+اثنين  → ث+أ+خ صباحي + جمعة مسائي + سبت ليلي
     سبت صباحي: إجازة خميس+جمعة → أحد+اثنين+ث+أ صباحي + سبت صباحي
     الباقون  : إجازة جمعة+سبت   → أحد–خميس صباحي
     التغطية: أحد=3 | اثنين=3 | ث+أ=4 | خميس=3 | جمعة=1مسائي | سبت=2 */
  /* دورة معتمدة — الجمعة إجازة للجميع — سبت=1 صباحي فقط — كل الإجازات متتالية ✓
     سبت صباحي (idx=wk): إجازة خميس+جمعة ✓ → أحد،اثنين،ثلاثاء،أربعاء،سبت صباحي
     الباقون (3)        : إجازة جمعة+سبت  ✓ → أحد–خميس صباحي
     التغطية: أحد–أربعاء=4 | خميس=3 | جمعة=0 | سبت=1 */
  /* دورة معتمدة — الجمعة إجازة للجميع — السبت شخص واحد صباحي — إجازات متتالية ✓
     idx=wk: سبت صباحي → أحد-أربعاء صباحي + سبت صباحي | إجازة خميس+جمعة ✓
     الباقون: أحد-خميس صباحي                           | إجازة جمعة+سبت  ✓ */
  if(mi===wk%n) return [M,M,M,M,O,O,M]; /* سبت صباحي (9:00ص-7:00م) | إجازة خميس+جمعة ✓ */
  return [M,M,M,M,M,O,O];               /* أحد-خميس                 | إجازة جمعة+سبت  ✓ */
}
function getShifts(emp,ws){
  var b=baseShifts(emp,ws);
  for(var d=0;d<7;d++){
    var dt=aD(ws,d);
    var wd=dt.getDay();
    if(onLeave(emp.id,dt)){b[d]=L;continue;}
    var cv=nightCover(dt);
    var anyFixedOnLeave=EMPS.some(function(fe){return fe.fixed&&onLeave(fe.id,dt);});
    if(cv&&cv===emp.id&&anyFixedOnLeave&&wd>=0&&wd<=4)b[d]=C;
  }
  return b;
}
function getOff(s){var days=LANG==='en'?DAYS_EN:DAYS_AR;return days.map(function(d,i){return s[i]===O?d:null;}).filter(Boolean).join(' + ');}
function consec(s){
  var offs=s.map(function(v,i){return v===O?i:-1;}).filter(function(x){return x>=0;});
  if(offs.length!==2)return false;
  return(offs[1]-offs[0]===1)||(offs[0]===0&&offs[1]===6);
}

