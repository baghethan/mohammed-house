      h+='<span style="font-size:11px;color:#444;flex:1">'+fmtF(sd)+' &larr; '+fmtF(ed)+' <b>('+days+' يوم)</b></span>';
      h+='<span style="font-size:10.5px;color:#777;font-style:italic;flex:1">'+lv.reason+'</span>';
      h+=stEl;
      h+='<button class="nb br" style="padding:3px 9px;font-size:10px" onclick="delLeave(\''+lv.id+'\')">&#10005;</button>';
      h+='</div>';
    }
  }
  h+='</div>';
  return h;
}

function renderEmployees(){
  var isEdit=openForm==='emp'&&editingEmp;
  var eEmp=isEdit?findEmp(editingEmp):null;
  var h='<div class="sec-hdr"><h3>&#128101; إدارة الموظفين</h3>';
  h+='<div style="display:flex;gap:6px;flex-wrap:wrap">';
  h+='<button class="nb bg" onclick="togForm(\'emp\')">&#10133; موظف جديد</button>';
  h+='<button class="nb bn" onclick="doExportCSV()" style="background:#1565c0" title="تصدير CSV للتعديل في Excel">&#8659; CSV</button>';
  h+='<button class="nb bn" onclick="doExportJSON()" style="background:#4a148c" title="تصدير JSON نسخة احتياطية">&#8659; JSON</button>';
  h+='<button class="nb by" onclick="triggerImport()" title="رفع ملف CSV او JSON معدّل">&#8657; استيراد</button>';
  h+='<input type="file" id="importFile" accept=".json,.csv" style="display:none" onchange="handleImport(this)">';
  h+='</div></div>';
  if(openForm==='emp'){
    h+='<div class="formbox"><h3>'+(isEdit?'&#9998; تعديل بيانات الموظف':'&#10133; إضافة موظف جديد')+'</h3>';
    h+='<div class="fgrid">';
    h+='<div><label>الاسم الكامل *</label><input id="nn" type="text" value="'+(eEmp?eEmp.name:'')+'" placeholder="اكتب الاسم..."></div>';
    h+='<div><label>الفئة الوظيفية *</label><select id="ncat" onchange="onCatChg()">';
    var ckeys=Object.keys(CATS);
    for(var ki=0;ki<ckeys.length;ki++){
      var k=ckeys[ki];
      h+='<option value="'+k+'"'+((eEmp?eEmp.category:'emp')===k?' selected':'')+'>'+CATS[k].label+'</option>';
    }
    h+='</select></div>';
    for(var fi=0;fi<EXTRA_FIELDS.length;fi++){
      var f=EXTRA_FIELDS[fi];
      h+='<div><label>'+f.label+'</label><input id="ef_'+f.key+'" type="'+f.type+'" value="'+(eEmp?eEmp[f.key]||'':'')+'" placeholder="'+f.ph+'"></div>';
    }
    /* Region selector */
    var empR2=eEmp?eEmp.region||'eastern':'eastern';
    h+='<div><label>المنطقة / Region</label><select id="nemp-region">';
    h+='<option value="eastern"'+(empR2==='eastern'?' selected':'')+'>المنطقة الشرقية (7:30ص-5:00م)</option>';
    h+='<option value="riyadh"'+(empR2==='riyadh'?' selected':'')+'>الرياض (8:00ص-5:30م)</option>';
    h+='<option value="jeddah"'+(empR2==='jeddah'?' selected':'')+'>جدة (8:00ص-5:30م)</option>';
    h+='</select></div>';
    if(!eEmp||!eEmp.fixed){ /* show for all non-fixed: emp, tra, tam, sup, mgr */
      var rotYes=eEmp?!!eEmp.rotates:false;
      h+='<div id="rot-field"><label>يدخل في تغيير الدوام؟</label><select id="nrot">';
      h+='<option value="no"'+(rotYes?'':' selected')+'>لا - دوام ثابت احد-خميس فقط</option>';
      h+='<option value="yes"'+(rotYes?' selected':'')+'>نعم - يدخل دورة الجمعة والسبت</option>';
      h+='</select></div>';
    }
    h+='</div>';
    h+='<div class="fnote">&#128274; البريد يجب ان يكون <b>@almajdouie.com</b> فقط</div>';
    h+='<div class="fbtn-row"><button class="nb bg" onclick="saveEmp()" style="padding:7px 16px;font-size:12px">&#10004; '+(isEdit?'حفظ التعديلات':'إضافة للجدول')+'</button>';
    h+='<button class="nb bn" onclick="cancForm()" style="background:#666;padding:7px 12px">الغاء</button></div></div>';
  }
  h+='<div class="emp-list">';
  var cats2=['emp','sup','mgr','tra','tam'];
  for(var c2=0;c2<cats2.length;c2++){
    var cat2=cats2[c2];
    var grp=EMPS.filter(function(e){return e.category===cat2;});
    if(!grp.length)continue;
    h+='<div style="padding:6px 0 3px;font-size:11.5px;font-weight:700;color:#555;display:flex;align-items:center;gap:6px">'+catBadge(cat2)+' '+CATS[cat2].label+' ('+grp.length+')</div>';
    for(var g2=0;g2<grp.length;g2++){
      var e2=grp[g2];
      var lvC=LEAVES.filter(function(lv2){return lv2.empId===e2.id;}).length;
      var alvC=LEAVES.filter(function(lv2){return lv2.empId===e2.id&&lvStatus(lv2)==='active';}).length;
      var cls2=!e2.active?'emp-off':(!e2.core?'emp-on':'');
      h+='<div class="emp-item '+cls2+'">';
      h+='<div style="flex:1;min-width:190px">';
      h+='<div style="font-weight:700;color:#1a3558;font-size:12px">'+e2.name;
      if(e2.empNum)h+=' <span style="font-size:9px;color:#888;background:#f0f0f0;border-radius:4px;padding:1px 5px">#'+e2.empNum+'</span>';
      if(e2.core)h+=' <span class="tag" style="background:#e3f2fd;color:#0d47a1">اساسي</span>';
      h+='</div>';
      var meta=[];
      if(e2.jobTitle)meta.push('<b>'+e2.jobTitle+'</b>');
      if(e2.dept)meta.push(e2.dept);
      if(e2.email)meta.push('<span style="direction:ltr;display:inline-block;color:#1565c0">'+e2.email+'</span>');
      if(e2.phone)meta.push(e2.phone);
      var rgnLbl=LANG==='en'?REGIONS[e2.region||'eastern'].label_en:REGIONS[e2.region||'eastern'].label_ar;
      var rgnTime=morningTime(e2.region||'eastern');
      meta.push('<span style="color:#1b5e20;font-size:9.5px">&#127759; '+rgnLbl+' ('+rgnTime+')</span>');
      if(meta.length)h+='<div style="font-size:10px;color:#666;margin-top:2px">'+meta.join(' | ')+'</div>';
      if(alvC)h+='<div style="font-size:10px;color:#7b1fa2;margin-top:2px">&#128197; في اجازة خاصة الان</div>';
      else if(lvC)h+='<div style="font-size:10px;color:#aaa;margin-top:2px">'+lvC+' اجازة مسجلة</div>';
      h+='</div>';
      if(e2.fixed)h+='<span class="badge-night">&#127761; ليلي ثابت</span>';
      else if(e2.rotates&&e2.active)h+='<span class="badge-rot">&#128260; في التناوب</span>';
      else if(!e2.rotates&&e2.active)h+='<span class="badge-fix">&#128197; دوام ثابت</span>';
      if(!e2.fixed)h+='<span class="'+(e2.active?'badge-on':'badge-off2')+'">'+(e2.active?'&#9989; مفعّل':'&#9208; موقوف')+'</span>';
      h+='<button class="nb bn" style="padding:5px 11px;font-size:11px" onclick="editEmp(\''+e2.id+'\')">&#9998; '+T('تعديل','Edit')+'</button>';
      if(e2.fixed){
        h+='<button class="nb bpur" style="padding:5px 12px;font-size:11px" onclick="togFixed(\''+e2.id+'\')">&#127761; '+T('إلغاء الليلي','Remove Night')+'</button>';
      } else {
        h+='<button class="nb" style="padding:5px 12px;font-size:11px;background:#4a1d96;color:#fff;border:none;border-radius:7px;cursor:pointer" onclick="togFixed(\''+e2.id+'\')">&#127761; '+T('تثبيت ليلي','Set Night')+'</button>';
      }
      /* rotation toggle — all non-fixed */
      if(!e2.fixed)h+='<button class="nb" style="padding:5px 11px;font-size:11px;background:'+(e2.rotates?'#7b1fa2':'#546e7a')+';color:#fff" onclick="togRotation(\''+e2.id+'\')">'+(e2.rotates?'&#128260; في التناوب':'&#128197; ثابت فقط')+'</button>';
      /* active/inactive toggle — non-core only */
      if(!e2.core)h+='<button class="nb by" style="padding:5px 11px;font-size:11px" onclick="togActive(\''+e2.id+'\')">'+(e2.active?'&#9208; إيقاف':'&#9654; تفعيل')+'</button>';
      /* delete / terminate */
      if(e2.core)h+='<button class="nb bpur" style="padding:5px 12px;font-size:11px" onclick="delEmp(\''+e2.id+'\')">&#128465; إنهاء خدمة</button>';
      else h+='<button class="nb br" style="padding:5px 12px;font-size:11px" onclick="delEmp(\''+e2.id+'\')">&#10005; حذف</button>';
      h+='</div>';
    }
  }
  h+='</div>';
  h+='<div style="padding:8px 16px 12px;font-size:10px;color:#888;border-top:1px solid #eef0f5;line-height:1.7">';
  h+='&#8659; CSV: تصدير لـ Excel للتعديل الجماعي &nbsp;|&nbsp; &#8659; JSON: نسخة احتياطية كاملة &nbsp;|&nbsp; &#8657; استيراد: رفع الملف المعدّل لتحديث البيانات &nbsp;|&nbsp; &#128274; @almajdouie.com فقط';
  h+='</div>';
  return h;
}

function renderEmail(){
  var we=aD(curSun,6);
  var wn=Math.abs(Math.round((curSun-REF)/(7*86400000)))+1;
  var withEmail=EMPS.filter(function(e){return e.active&&e.email&&validEmail(e.email);});
  var h='<div class="sec-hdr"><h3>&#9993; ارسال جداول الدوام عبر Outlook</h3>';
  h+='<button class="nb bg" onclick="sendAll()" style="font-size:12px">&#128232; ارسال للجميع ('+withEmail.length+')</button></div>';
  h+='<div style="padding:10px 16px;background:#e8f4fd;border-bottom:1px solid #b3d9f5;font-size:11px;color:#0d47a1;line-height:1.7">';
  h+='&#128197; <b>الاسبوع '+wn+':</b> '+fmtF(curSun)+' - '+fmtF(we)+'&nbsp;|&nbsp;';
  h+='&#9993; يفتح Outlook تلقائياً مع الجدول&nbsp;|&nbsp;';
  h+='&#128274; يُقبل فقط <b>@almajdouie.com</b></div>';
  h+='<div style="padding:12px 16px">';
  for(var ei=0;ei<EMPS.length;ei++){
    var e=EMPS[ei];
    if(!e.active)continue;
    var sh=getShifts(e,curSun);
    var sn2={morning:'صباحي',night:'ليلي',afternoon:'مسائي',off:'اجازة',leave:'اجازة خاصة',inactive:'موقوف',watch:'ثابت',cover:'ليلي بديل'};
    var schedTxt=DAYS_AR.map(function(day,i){return day+': '+(shiftNames2[sh[i]]||sh[i]);}).join(' | ');
    var hasEm=!!(e.email&&validEmail(e.email));
    h+='<div class="email-row'+(hasEm?' has-email':'')+'">';
    h+='<div class="emp-card">';
    h+='<div class="ename">'+e.name;
    if(e.empNum)h+=' <span style="font-size:9.5px;color:#888">#'+e.empNum+'</span>';
    h+='</div>';
    h+='<div class="emeta">'+catBadge(e.category);
    if(e.jobTitle)h+=' '+e.jobTitle;
    h+='<br><span style="font-size:9.5px;color:#aaa">'+schedTxt+'</span>';
    h+='</div></div>';
    h+='<div style="flex:1;min-width:220px">';
    h+='<div style="font-size:10px;color:#555;margin-bottom:4px">البريد الالكتروني:</div>';
    if(hasEm){
      h+='<div style="font-size:12px;font-weight:700;color:#1565c0;direction:ltr;background:#e8f4fd;border-radius:6px;padding:6px 10px;border:1px solid #90cbe8">'+e.email+'</div>';
      h+='<div style="font-size:9.5px;color:#1b5e20;margin-top:3px">&#9989; جاهز للإرسال</div>';
    } else {
      h+='<div style="font-size:11px;color:#b71c1c;background:#fce4ec;border-radius:6px;padding:6px 10px;border:1px solid #f48fb1">&#9888; لم يُضف بريد &nbsp;<a href="#" onclick="editEmp(\''+e.id+'\');return false;" style="color:#1565c0">اضف الان</a></div>';
    }
    h+='</div>';
    if(hasEm){
      h+='<button class="nb bbl" style="padding:8px 16px;font-size:12px;white-space:nowrap" onclick="sendEmail(\''+e.id+'\')">&#128231; فتح Outlook</button>';
    } else {
      h+='<button class="nb" style="padding:8px 14px;font-size:11px;background:#ddd;color:#999;cursor:not-allowed" disabled>اضف البريد اولاً</button>';
    }
    h+='</div>';
  }
  h+='</div>';
  h+='<div style="padding:8px 16px 12px;font-size:10px;color:#888;border-top:1px solid #eef0f5;line-height:1.7">';
  h+='&#128204; لإضافة البريد: تبويب الموظفون &rarr; تعديل &nbsp;|&nbsp; &#9993; الإرسال يفتح Outlook مع الجدول جاهزاً &nbsp;|&nbsp; &#128274; @almajdouie.com فقط';
  h+='</div>';
  return h;
}

