window.handleImport=function(input){
  var file=input.files[0];
  if(!file)return;
  var ext=file.name.split('.').pop().toLowerCase();
  var reader=new FileReader();
  reader.onload=function(ev){
    try{
      if(ext==='json'){
        var data=JSON.parse(ev.target.result);
        if(!data.emps||!Array.isArray(data.emps)){alert('ملف JSON غير صالح');return;}
        data.emps.forEach(function(emp){
          if(emp.email&&!validEmail(emp.email))emp.email='';
          EXTRA_FIELDS.forEach(function(f){if(emp[f.key]===undefined)emp[f.key]='';});
          if(emp.active===undefined)emp.active=true;
          if(emp.rotates===undefined)emp.rotates=false;
          if(emp.fixed===undefined)emp.fixed=false;
        });
        if(confirm('استيراد '+data.emps.length+' موظف - هل تريد المتابعة؟')){
          EMPS=data.emps;
          if(data.leaves)LEAVES=data.leaves;
          saveState();render();
          alert('تم الاستيراد بنجاح');
        }
      } else if(ext==='csv'){
        var lines2=ev.target.result.replace(/^\uFEFF/,'').split('\n').filter(function(l){return l.trim();});
        if(lines2.length<2){alert('الملف فارغ');return;}
        var catMap={};
        Object.keys(CATS).forEach(function(k){catMap[CATS[k].label]=k;});
        var updated=0,added=0;
        for(var i=1;i<lines2.length;i++){
          var cols=lines2[i].split(',').map(function(c){return c.replace(/^"|"$/g,'').trim();});
          if(!cols[0])continue;
          var ex=EMPS.find(function(e2){return e2.name===cols[0];});
          if(ex){
            if(cols[1])ex.category=catMap[cols[1]]||ex.category;
            if(cols[2])ex.jobTitle=cols[2];
            if(cols[3])ex.empNum=cols[3];
            if(cols[4]&&validEmail(cols[4]))ex.email=cols[4];
            if(cols[5])ex.phone=cols[5];
            if(cols[6])ex.dept=cols[6];
            if(cols[7])ex.active=cols[7]!=='موقوف';
            if(cols[8])ex.rotates=cols[8]==='نعم';
            updated++;
          } else {
            var em2=(cols[4]&&validEmail(cols[4]))?cols[4]:'';
            var obj2={id:'e'+Date.now()+i,name:cols[0],category:catMap[cols[1]]||'emp',
              jobTitle:cols[2]||'',empNum:cols[3]||'',email:em2,phone:cols[5]||'',dept:cols[6]||'',
              active:cols[7]!=='موقوف',rotates:cols[8]==='نعم',fixed:false,core:false};
            EXTRA_FIELDS.forEach(function(f){if(obj2[f.key]===undefined)obj2[f.key]='';});
            EMPS.push(obj2);added++;
          }
        }
        saveState();render();
        alert('تم: '+updated+' معدّل، '+added+' جديد');
      } else {
        alert('يرجى رفع ملف JSON او CSV فقط');
      }
    } catch(err){alert('خطا في قراءة الملف: '+err.message);}
  };
  reader.readAsText(file,'UTF-8');
  input.value='';
};

